# Speakflow Electron Desktop — environment template
# Copy to .env (which is gitignored) and fill in values for local dev.

# Groq Whisper API — used directly only in dev. In production the desktop
# app calls the Railway proxy instead and this is unset.
GROQ_API_KEY=

# Optional: override the dashboard URL for local dashboard development only.
# Leave unset to always load the production dashboard from Vercel (default).
# DASHBOARD_URL=http://localhost:5173

# Optional override for the API base URL when calling the Railway proxy.
# Leave empty in dev to call Groq directly.
SPEAKFLOW_API_URL=

# Build mode: development | production
NODE_ENV=development
